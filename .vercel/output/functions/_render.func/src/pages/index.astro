---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Press to Blog Converter" description="Transform press releases into beautiful blog posts instantly.">
    <Header currentPage="/" />
    
    <main>
        <!-- Hero -->
        <section class="hero container">
            <h1>Press <span>→</span> Blog</h1>
            <p class="hero-tagline">Paste any press release. Get a beautifully formatted blog post ready to publish.</p>
        </section>

        <!-- Ad -->
        <div class="container">
            <div class="ad-placeholder leaderboard">📢 AD SPACE — Google AdSense</div>
        </div>

        <!-- Tool Container -->
        <div class="tool-container container">
            
            <!-- Stage Navigation -->
            <div class="stages-nav">
                <button class="stage-btn active" data-stage="1">
                    <span class="stage-number">1</span>
                    <span>Input</span>
                </button>
                <button class="stage-btn" data-stage="2">
                    <span class="stage-number">2</span>
                    <span>Parse</span>
                </button>
                <button class="stage-btn" data-stage="3">
                    <span class="stage-number">3</span>
                    <span>Refine</span>
                </button>
                <button class="stage-btn" data-stage="4">
                    <span class="stage-number">4</span>
                    <span>Compose</span>
                </button>
                <button class="stage-btn" data-stage="5">
                    <span class="stage-number">5</span>
                    <span>Export</span>
                </button>
            </div>

            <!-- STAGE 1: INPUT -->
            <div class="stage-content active" id="stage-1">
                <div class="stage-header">
                    <h2>📥 Stage 1: Paste Your Press Release</h2>
                    <p>Copy the text from any official press release and paste it below. We support PIB India, company PRs, and more.</p>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Raw Press Release Text</label>
                    <textarea 
                        id="raw-input" 
                        class="form-textarea raw-input" 
                        placeholder="Paste the press release text here..."
                    >Ministry of New and Renewable Energy

Government of India approves National Green Hydrogen Mission with an outlay of Rs. 19,744 crore.

Posted On: 04 JAN 2023 3:45PM by PIB Delhi

New Delhi: The Union Cabinet, chaired by Prime Minister Shri Narendra Modi, has approved the National Green Hydrogen Mission. The initial outlay for the Mission will be Rs. 19,744 crore, including an outlay of Rs. 17,490 crore for the SIGHT programme, Rs. 1,466 crore for pilot projects, Rs. 400 crore for R&D, and Rs. 388 crore towards other Mission components.

"The National Green Hydrogen Mission will place India at the forefront of clean energy transition, reducing fossil fuel imports and creating over six lakh jobs by 2030," Union Minister Anurag Thakur stated during the briefing.

The Mission aims to deliver an annual production of 5 MMT (Million Metric Tonnes) of Green Hydrogen by 2030, with an associated renewable energy capacity addition of about 125 GW. It will bring over Rs. 8 lakh crore in total investments and abate nearly 50 MMT of annual greenhouse gas emissions.</textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Source Type</label>
                    <select id="source-type" class="form-select">
                        <option value="pib">Press Information Bureau (PIB)</option>
                        <option value="company">Company Press Release</option>
                        <option value="ministerial">Ministerial Statement</option>
                        <option value="other">Other Source</option>
                    </select>
                </div>

                <button class="btn btn-primary" id="parse-btn">
                    🔍 Run Auto-Parse →
                </button>
            </div>

            <!-- STAGE 2: PARSE -->
            <div class="stage-content" id="stage-2">
                <div class="stage-header">
                    <h2>🔍 Stage 2: Extracted Parameters</h2>
                    <p>We've analyzed your press release and extracted the key information. Review and edit below.</p>
                </div>

                <div class="params-grid">
                    <div class="param-card">
                        <h4>Ministry / Source</h4>
                        <div class="value" id="extracted-source">-</div>
                    </div>
                    <div class="param-card">
                        <h4>Date</h4>
                        <div class="value" id="extracted-date">-</div>
                    </div>
                    <div class="param-card">
                        <h4>Location</h4>
                        <div class="value" id="extracted-location">-</div>
                    </div>
                    <div class="param-card">
                        <h4>Headline</h4>
                        <div class="value" id="extracted-headline">-</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Key Quote</label>
                    <textarea id="extracted-quote" class="form-textarea" style="min-height: 100px;" placeholder="Key statement from the release..."></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Key Figures (one per line)</label>
                    <textarea id="extracted-figures" class="form-textarea" style="min-height: 100px;" placeholder="• Figure 1&#10;• Figure 2&#10;• Figure 3"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Context / Summary</label>
                    <textarea id="extracted-context" class="form-textarea" style="min-height: 100px;" placeholder="Brief context about the announcement..."></textarea>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="proceed-refine">
                        ✏️ Proceed to Refine →
                    </button>
                    <button class="btn btn-secondary" id="back-to-input">
                        ← Back to Input
                    </button>
                </div>
            </div>

            <!-- STAGE 3: REFINE -->
            <div class="stage-content" id="stage-3">
                <div class="stage-header">
                    <h2>✏️ Stage 3: Refine & Edit</h2>
                    <p>Fine-tune the extracted parameters to match your style and ensure accuracy.</p>
                </div>

                <div class="params-grid">
                    <div class="form-group">
                        <label class="form-label">Title</label>
                        <input type="text" id="refine-title" class="form-input" placeholder="Your blog post title">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select id="refine-category" class="form-select">
                            <option value="government">Government</option>
                            <option value="business">Business</option>
                            <option value="technology">Technology</option>
                            <option value="economy">Economy</option>
                            <option value="health">Health</option>
                            <option value="environment">Environment</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Intro Paragraph</label>
                    <textarea id="refine-intro" class="form-textarea" style="min-height: 120px;" placeholder="Auto-generated from parsing, or write your own intro..."></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Blog Format</label>
                    <select id="refine-format" class="form-select">
                        <option value="article">📄 News Article</option>
                        <option value="brief">📋 Quick Brief (bullet points)</option>
                        <option value="thread">🐦 Tweet Thread Style</option>
                    </select>
                </div>

                <!-- AI Enhancement Section -->
                <div class="ai-section">
                    <div class="ai-header">
                        <span class="ai-icon">✨</span>
                        <span>AI Enhancement</span>
                    </div>
                    <p class="ai-description">Use AI to generate a detailed, engaging blog post from your extracted content.</p>
                    
                    <div class="ai-options">
                        <label class="ai-option">
                            <input type="radio" name="ai-mode" value="basic" checked>
                            <span>📝 Basic (Quick)</span>
                            <small>Use local formatting</small>
                        </label>
                        <label class="ai-option">
                            <input type="radio" name="ai-mode" value="ai">
                            <span>🤖 AI Enhanced</span>
                            <small>GPT-powered detailed post</small>
                        </label>
                    </div>
                    
                    <div id="ai-loading" class="ai-loading" style="display: none;">
                        <div class="spinner"></div>
                        <span>Generating with AI...</span>
                    </div>
                    
                    <div id="ai-error" class="ai-error" style="display: none;"></div>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="generate-post">
                        ✍️ Generate Blog Post
                    </button>
                    <button class="btn btn-secondary" id="back-to-parse">
                        ← Back to Parse
                    </button>
                </div>
            </div>

            <!-- STAGE 4: COMPOSE -->
            <div class="stage-content" id="stage-4">
                <div class="stage-header">
                    <h2>✍️ Stage 4: Your Blog Post</h2>
                    <p>Here's your generated blog post. Review it and make any final tweaks.</p>
                </div>

                <!-- Preview -->
                <div class="preview-box" id="preview-box">
                    <h1 class="preview-title" id="preview-title">Your Title Here</h1>
                    <p class="preview-meta" id="preview-meta">Category • Date</p>
                    
                    <div class="preview-content" id="preview-content">
                        <p>Your blog content will appear here...</p>
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="proceed-export">
                        📤 Proceed to Export →
                    </button>
                    <button class="btn btn-secondary" id="back-to-refine">
                        ← Edit More
                    </button>
                </div>
            </div>

            <!-- STAGE 5: EXPORT -->
            <div class="stage-content" id="stage-5">
                <div class="stage-header">
                    <h2>📤 Stage 5: Export & Share</h2>
                    <p>Copy your blog post as Markdown, download it, or share it directly.</p>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="copy-markdown">
                        📋 Copy Markdown
                    </button>
                    <button class="btn btn-secondary" id="download-md">
                        📥 Download .md
                    </button>
                    <button class="btn btn-success" id="copy-html">
                        🌐 Copy HTML
                    </button>
                </div>

                <div class="form-group" style="margin-top: 2rem;">
                    <label class="form-label">Raw Markdown Output</label>
                    <div class="markdown-output" id="markdown-output">
                        Your markdown will appear here...
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn btn-primary" id="start-new">
                        🔄 Start New Post
                    </button>
                    <button class="btn btn-secondary" id="back-to-compose">
                        ← Back to Preview
                    </button>
                </div>
            </div>

        </div>

        <!-- Ad -->
        <div class="container">
            <div class="ad-placeholder leaderboard">📢 AD SPACE — Google AdSense</div>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    // Stage Navigation
    const stageBtns = document.querySelectorAll('.stage-btn');
    const stages = document.querySelectorAll('.stage-content');
    let currentStage = 1;

    function showStage(n) {
        currentStage = n;
        stageBtns.forEach((btn, i) => {
            btn.classList.toggle('active', i + 1 === n);
            btn.classList.toggle('completed', i + 1 < n);
        });
        stages.forEach((stage, i) => {
            stage.classList.toggle('active', i + 1 === n);
        });
    }

    stageBtns.forEach((btn, i) => {
        btn.addEventListener('click', () => showStage(i + 1));
    });

    // Navigation Buttons
    document.getElementById('parse-btn')?.addEventListener('click', () => {
        runParser();
        showStage(2);
    });

    document.getElementById('proceed-refine')?.addEventListener('click', () => showStage(3));
    document.getElementById('back-to-input')?.addEventListener('click', () => showStage(1));
    
    document.getElementById('generate-post')?.addEventListener('click', () => {
        generatePost();
        showStage(4);
    });
    document.getElementById('back-to-parse')?.addEventListener('click', () => showStage(2));
    
    document.getElementById('proceed-export')?.addEventListener('click', () => {
        showStage(5);
    });
    document.getElementById('back-to-refine')?.addEventListener('click', () => showStage(3));
    
    document.getElementById('back-to-compose')?.addEventListener('click', () => showStage(4));
    document.getElementById('start-new')?.addEventListener('click', () => showStage(1));

    // ===== IMPROVED PARSER =====
    
    function runParser() {
        const rawText = (document.getElementById('raw-input') as HTMLTextAreaElement)?.value || '';
        const sourceType = (document.getElementById('source-type') as HTMLSelectElement)?.value || 'pib';
        
        if (!rawText.trim()) {
            alert('Please paste a press release first!');
            return;
        }
        
        // Clean text
        const cleanText = rawText.replace(/\s+/g, ' ').trim();
        
        // ===== 1. EXTRACT SOURCE/MINISTRY =====
        let source = extractSource(cleanText, sourceType);
        
        // ===== 2. EXTRACT DATE =====
        const date = extractDate(cleanText);
        
        // ===== 3. EXTRACT LOCATION =====
        const location = extractLocation(cleanText);
        
        // ===== 4. EXTRACT HEADLINE =====
        const headline = extractHeadline(cleanText);
        
        // ===== 5. EXTRACT KEY QUOTE =====
        const quote = extractQuote(cleanText);
        
        // ===== 6. EXTRACT KEY FIGURES =====
        const figures = extractFigures(cleanText);
        
        // ===== 7. EXTRACT CONTEXT =====
        const context = extractContext(cleanText, headline);
        
        // ===== UPDATE UI =====
        const setText = (id: string, val: string) => {
            const el = document.getElementById(id);
            if (el) el.textContent = val || 'Not detected';
        };
        
        const setValue = (id: string, val: string) => {
            const el = document.getElementById(id) as HTMLTextAreaElement;
            if (el) el.value = val || '';
        };
        
        setText('extracted-source', source);
        setText('extracted-date', date);
        setText('extracted-location', location);
        setText('extracted-headline', headline);
        
        setValue('extracted-quote', quote);
        setValue('extracted-figures', figures.length > 0 ? figures.map(f => `• ${f}`).join('\n') : '');
        setValue('extracted-context', context);
        
        // Also update Stage 3 fields for better workflow
        setValue('refine-title', headline !== 'News Update' ? headline : '');
        
        // Auto-generate intro from context
        if (context && context !== 'Summary not available') {
            const introParagraph = `The ${source} today announced ${headline.toLowerCase()}. ${context.substring(0, 200)}...`;
            setValue('refine-intro', introParagraph);
        }
        
        // Show success message
        const parseBtn = document.getElementById('parse-btn');
        if (parseBtn) {
            parseBtn.textContent = '✅ Parsed Successfully!';
            setTimeout(() => {
                parseBtn.textContent = '🔍 Run Auto-Parse →';
            }, 2000);
        }
    }
    
    // ===== EXTRACT SOURCE/MINISTRY =====
    function extractSource(text: string, sourceType: string): string {
        // Check for Ministry pattern (PIB style)
        const ministryPatterns = [
            /Ministry\s+of\s+[\w\s&,]+?(?=\.|\n|Government|has|will|will)/gi,
            /Department\s+of\s+[\w\s&,]+/gi,
            /(?:Shri|Smt|Mr|Ms)\s+[\w\s]+\s+(?:said|stated|announced|added|mentioned)/gi,
            /Press\s+Information\s+Bureau/gi,
            /(?:Govt|Government)\s+of\s+India/gi,
        ];
        
        for (const pattern of ministryPatterns) {
            const match = text.match(pattern);
            if (match && match[0].length > 5 && match[0].length < 100) {
                return match[0].trim();
            }
        }
        
        // Check for company name at start
        const companyPatterns = [
            /(?:Company|Inc|Corp|Ltd|Private)\s+[\w\s]+/gi,
            /[\w\s]+:\s*(?:New Delhi|Mumbai|Bengaluru)/gi,
        ];
        
        for (const pattern of companyPatterns) {
            const match = text.match(pattern);
            if (match) return match[0].trim();
        }
        
        // Default based on source type
        const defaults: Record<string, string> = {
            'pib': 'Press Information Bureau (PIB)',
            'company': 'Company Press Release',
            'ministerial': 'Ministerial Statement',
            'other': 'Press Release'
        };
        
        return defaults[sourceType] || 'Press Release';
    }
    
    // ===== EXTRACT DATE =====
    function extractDate(text: string): string {
        const datePatterns = [
            // PIB Style: "Posted On: 04 JAN 2023 3:45PM by PIB Delhi"
            /Posted\s+On:?\s*(\d{1,2}\s+\w+\s+\d{4})/i,
            // "New Delhi, Jan 4, 2023"
            /(\d{1,2}\s+\w+\s+\d{4})/i,
            // "January 4, 2023"
            /(\w+\s+\d{1,2},?\s+\d{4})/i,
            // ISO: "2023-01-04"
            /(\d{4}-\d{2}-\d{2})/,
            // "04/01/2023" or "04-01-2023"
            /(\d{1,2}[-\/]\d{1,2}[-\/]\d{2,4})/,
            // "Released on: 4th January 2023"
            /Released\s+on:?\s*(\d{1,2}\s+\w+\s+\d{4})/i,
            // "Date: 04-01-2023"
            /Date:?\s*(\d{1,2}[-\/]\d{1,2}[-\/]\d{2,4})/i,
        ];
        
        for (const pattern of datePatterns) {
            const match = text.match(pattern);
            if (match && match[1]) {
                let date = match[1].trim();
                // Convert to readable format
                date = date.replace(/(\d{4})-(\d{2})-(\d{2})/, '$3-$2-$1');
                return date;
            }
        }
        
        return new Date().toLocaleDateString('en-IN', { 
            day: '2-digit', 
            month: 'short', 
            year: 'numeric' 
        });
    }
    
    // ===== EXTRACT LOCATION =====
    function extractLocation(text: string): string {
        const cities = [
            'New Delhi', 'Mumbai', 'Bengaluru', 'Bangalore', 'Chennai', 
            'Kolkata', 'Hyderabad', 'Pune', 'Ahmedabad', 'Jaipur',
            'Lucknow', 'Chandigarh', 'Bhopal', 'Patna', 'Guwahati',
            'New Delhi,', 'Mumbai,', 'Bengaluru,', 'Chennai,', 'Kolkata,'
        ];
        
        for (const city of cities) {
            const regex = new RegExp(`(${city})`, 'i');
            const match = text.match(regex);
            if (match) {
                return match[1].replace(',', '');
            }
        }
        
        return 'India';
    }
    
    // ===== EXTRACT HEADLINE =====
    function extractHeadline(text: string): string {
        const lines = text.split(/\n|\.\s+/).filter(l => l.trim());
        
        // Try to find headline patterns
        const headlinePatterns = [
            // After location: "New Delhi, Jan 4: The Finance Ministry..."
            /(?:New Delhi|Mumbai|Bengaluru|Chennai|Kolkata)[,:\s]+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\s,]+(?:The\s+)?([A-Z][^.!?]{10,80})/i,
            // Title Case line (likely headline)
            /^([A-Z][a-zA-Z\s]{10,100})$/m,
            // After "announces/announcement"
            /(?:announces?|announcement|launches?|introduces?)\s+(?:the\s+)?([A-Z][^.!?\n]{15,100})/i,
        ];
        
        for (const pattern of headlinePatterns) {
            const match = text.match(pattern);
            if (match && match[1]) {
                let headline = match[1].trim();
                headline = headline.replace(/\s+/g, ' ');
                if (headline.length > 15 && headline.length < 150) {
                    return headline;
                }
            }
        }
        
        // Find the longest capitalized line that could be a headline
        for (const line of lines.slice(0, 5)) {
            const trimmed = line.trim();
            if (trimmed.length > 20 && trimmed.length < 150) {
                // Check if it looks like a headline (no lowercase at start)
                if (/^[A-Z]/.test(trimmed) && !trimmed.includes(' said ') && !trimmed.includes(' stated ')) {
                    return trimmed;
                }
            }
        }
        
        return 'News Update';
    }
    
    // ===== EXTRACT KEY QUOTE =====
    function extractQuote(text: string): string {
        // Find quoted text with various quote styles
        const quotePatterns = [
            /"([^"]{20,300})"/g,
            /"([^"]{20,300})"/g,
            /'([^']{20,300})'/g,
            /«([^»]{20,300})»/g,
            /"([^"]{20,300})"/g,
        ];
        
        for (const pattern of quotePatterns) {
            let match;
            while ((match = pattern.exec(text)) !== null) {
                const quote = match[1].trim();
                // Filter out boilerplate quotes
                if (quote.length > 20 && !quote.includes('PIB') && !quote.includes('Copying') && !quote.includes('http')) {
                    return quote;
                }
            }
        }
        
        // Find quotes attributed to officials
        const attributionPatterns = [
            /(?:"([^"]{20,300})")/gi,
            /(?:stated|announced|said|added|mentioned|observed|noted)\s*[,:]?\s*(?:"([^"]{20,300})")/gi,
            /(?:Shri|Smt|Mr|Ms|Dr)\s+[\w\s]+(?::|,)\s*(?:"([^"]{20,300})")/gi,
        ];
        
        for (const pattern of attributionPatterns) {
            const match = text.match(pattern);
            if (match && match[1]) {
                const quote = match[1].trim();
                if (quote.length > 20) return quote;
            }
        }
        
        // Try to find a long descriptive sentence as fallback
        const sentences = text.match(/[^.!?]+[.!?]/g) || [];
        for (const sentence of sentences) {
            if (sentence.length > 100 && sentence.includes('will') || sentence.includes('aims') || sentence.includes('targets')) {
                return sentence.trim();
            }
        }
        
        return '';
    }
    
    // ===== EXTRACT KEY FIGURES =====
    function extractFigures(text: string): string[] {
        const figures: string[] = [];
        const seen = new Set<string>();
        
        // Rupee figures - match full pattern
        const rupeeRegex = /(?:Rs\.?|₹|INR)\s*([\d,]+(?:\.\d+)?)\s*(?:crore|cr|Cr|lakh|L|L\/-|Lacs)?/gi;
        let match;
        while ((match = rupeeRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let suffix = '';
            // Find the suffix that was matched
            const afterMatch = text.slice(match.index + match[0].length);
            const suffixMatch = afterMatch.match(/^(?:\s*(?:crore|cr|Cr|lakh|L|L\/-|Lacs)\b)?/i);
            if (suffixMatch && suffixMatch[0]) suffix = suffixMatch[0].trim();
            
            let figure = suffix ? `₹${parseFloat(val).toLocaleString('en-IN')} ${suffix}` : `₹${parseFloat(val).toLocaleString('en-IN')}`;
            
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // Percentage
        const percentRegex = /(\d+(?:\.\d+)?)\s*(?:%|per\s*cent)/gi;
        while ((match = percentRegex.exec(text)) !== null) {
            let figure = `${match[1]}%`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // Capacity - GW/MW
        const gwRegex = /([\d,]+)\s*(?:GW|MW|megawatt|gigawatt)/gi;
        while ((match = gwRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let unit = match[0].replace(/[\d,]/g, '').trim();
            let figure = `${parseFloat(val).toLocaleString('en-IN')} ${unit.toUpperCase()}`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // MMT/Million Tonnes
        const mmtRegex = /([\d,]+)\s*(?:MMT|Million\s*Tonnes?|MT|million)/gi;
        while ((match = mmtRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let unit = match[0].replace(/[\d,]/g, '').trim();
            let figure = `${parseFloat(val).toLocaleString('en-IN')} ${unit.toUpperCase()}`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // Jobs/People
        const jobsRegex = /([\d,]+)\s*(?:lakh|million|thousand|TH)?\s*(?:jobs|people)/gi;
        while ((match = jobsRegex.exec(text)) !== null) {
            let figure = match[0].trim();
            if (!seen.has(figure) && figure.length < 30) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // Power - PS/HP
        const psRegex = /([\d,]+)\s*(?:PS|HP|bhp|BHP)/gi;
        while ((match = psRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let figure = `${val} ${match[0].replace(/[\d,]/g, '').trim()}`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // CC
        const ccRegex = /([\d,]+)\s*(?:cc|CC)/gi;
        while ((match = ccRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let figure = `${val} cc`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        // Investment - Lakh Crore
        const investRegex = /Rs\.?\s*([\d,]+)\s*(?:lakh|lakhs)\s*(?:crore|crores?)?/gi;
        while ((match = investRegex.exec(text)) !== null) {
            let val = match[1].replace(/,/g, '');
            let figure = `₹${parseFloat(val).toLocaleString('en-IN')} lakh crore`;
            if (!seen.has(figure)) {
                seen.add(figure);
                figures.push(figure);
            }
        }
        
        return figures.slice(0, 10);
    }
    
    // ===== EXTRACT CONTEXT =====
    function extractContext(text: string, headline: string): string {
        // Remove the headline from text
        let contextText = text.replace(headline, '');
        
        // Remove boilerplate
        const boilerplatePatterns = [
            /This\s+is\s+with\s+reference.*$/gi,
            /Copying\s+restricted.*$/gi,
            /PIB\s+release.*$/gi,
            /^(?:Shri|Smt|Mr|Ms)\s+[\w\s]+\s+(?:said|stated|added).*$/gim,
            /(?:Posted\s+On|PIB\s+Delhi|Source\s+:).*$/gi,
            /\*\*.*?\*\*/g,
            /Ministry\s+of\s+[\w\s&,\.]+/gi,
            /Government\s+of\s+India.*$/gim,
        ];
        
        for (const pattern of boilerplatePatterns) {
            contextText = contextText.replace(pattern, '');
        }
        
        // Find the main content paragraph
        const paragraphs = contextText.split(/\n\n|\.\s+/).filter(p => p.trim().length > 50);
        
        for (const para of paragraphs) {
            const trimmed = para.trim();
            // Skip if it's too short, too long, or contains only numbers
            if (trimmed.length > 50 && trimmed.length < 500 && /\D/.test(trimmed)) {
                return trimmed;
            }
        }
        
        // Fallback: return first substantial paragraph
        return paragraphs[0]?.trim().substring(0, 500) || 'Summary not available';
    }

    // Generate Post
    function generatePost() {
        const aiMode = (document.querySelector('input[name="ai-mode"]:checked') as HTMLInputElement)?.value || 'basic';
        
        if (aiMode === 'ai') {
            generateWithAI();
        } else {
            generateBasic();
        }
    }
    
    // Basic Generation (Local)
    function generateBasic() {
        const title = (document.getElementById('refine-title') as HTMLInputElement)?.value || document.getElementById('extracted-headline')?.textContent || 'News Update';
        const category = (document.getElementById('refine-category') as HTMLSelectElement)?.value || 'news';
        const quote = (document.getElementById('extracted-quote') as HTMLTextAreaElement)?.value || '';
        const figures = (document.getElementById('extracted-figures') as HTMLTextAreaElement)?.value || '';
        const context = (document.getElementById('extracted-context') as HTMLTextAreaElement)?.value || '';
        const date = document.getElementById('extracted-date')?.textContent || '';
        const source = document.getElementById('extracted-source')?.textContent || '';
        const format = (document.getElementById('refine-format') as HTMLSelectElement)?.value || 'article';
        
        // Update preview
        document.getElementById('preview-title')!.textContent = title;
        document.getElementById('preview-meta')!.textContent = `${category.charAt(0).toUpperCase() + category.slice(1)} • ${date}`;
        
        let content = '';
        
        if (format === 'brief') {
            content = `
<p><strong>Quick Take:</strong> ${context.substring(0, 150)}...</p>

<h2>Key Points</h2>
${figures.split('\n').map(f => `<li>${f.replace('• ', '')}</li>`).join('')}
${quote ? `<blockquote class="preview-quote">"${quote}"</blockquote>` : ''}
            `;
        } else if (format === 'thread') {
            content = `
<p>🧵 Thread: ${title}</p>
<p>${context.substring(0, 200)}...</p>

${figures.split('\n').map((f, i) => `<p>${i + 1}. ${f.replace('• ', '')}</p>`).join('')}
${quote ? `<blockquote class="preview-quote">"${quote}"</blockquote>` : ''}
<p>${source} | ${date}</p>
            `;
        } else {
            content = `
${context ? `<p>${context.substring(0, 200)}...</p>` : ''}

${quote ? `<blockquote class="preview-quote">"${quote}"</blockquote>` : ''}

<h2>Key Highlights</h2>
<ul>
${figures.split('\n').map(f => `<li>${f.replace('• ', '')}</li>`).join('\n')}
</ul>

<p><em>Source: ${source} | ${date}</em></p>
            `;
        }
        
        document.getElementById('preview-content')!.innerHTML = content;
        
        // Generate Markdown
        const markdown = generateMarkdown(title, category, date, source, quote, figures, context, format);
        document.getElementById('markdown-output')!.textContent = markdown;
        
        // Move to Stage 4
        showStage(4);
    }
    
    // AI Generation
    async function generateWithAI() {
        const loadingEl = document.getElementById('ai-loading');
        const errorEl = document.getElementById('ai-error');
        const btnEl = document.getElementById('generate-post');
        
        // Show loading
        if (loadingEl) loadingEl.style.display = 'flex';
        if (errorEl) errorEl.style.display = 'none';
        if (btnEl) {
            (btnEl as HTMLButtonElement).disabled = true;
            btnEl.textContent = '⏳ Generating...';
        }
        
        try {
            const title = (document.getElementById('refine-title') as HTMLInputElement)?.value || document.getElementById('extracted-headline')?.textContent || 'News Update';
            const category = (document.getElementById('refine-category') as HTMLSelectElement)?.value || 'news';
            const quote = (document.getElementById('extracted-quote') as HTMLTextAreaElement)?.value || '';
            const figures = (document.getElementById('extracted-figures') as HTMLTextAreaElement)?.value || '';
            const context = (document.getElementById('extracted-context') as HTMLTextAreaElement)?.value || '';
            const date = document.getElementById('extracted-date')?.textContent || '';
            const source = document.getElementById('extracted-source')?.textContent || '';
            const format = (document.getElementById('refine-format') as HTMLSelectElement)?.value || 'article';
            
            const response = await fetch('/api/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    title,
                    source,
                    date,
                    location: 'India',
                    quote,
                    figures,
                    context,
                    format
                })
            });
            
            const data = await response.json();
            
            if (!response.ok) {
                throw new Error(data.error || 'Generation failed');
            }
            
            // Update preview with AI content
            document.getElementById('preview-title')!.textContent = title;
            document.getElementById('preview-meta')!.textContent = `${category.charAt(0).toUpperCase() + category.slice(1)} • ${date} • ✨ AI Generated`;
            document.getElementById('preview-content')!.innerHTML = data.content.replace(/\n/g, '<br>');
            document.getElementById('markdown-output')!.textContent = `# ${title}\n\n${data.content}\n\n---\n*Source: ${source} | Generated by PressFolio AI*`;
            
            // Move to Stage 4
            showStage(4);
            
        } catch (error) {
            console.error('AI Generation Error:', error);
            if (errorEl) {
                errorEl.textContent = `❌ Error: ${error instanceof Error ? error.message : 'Something went wrong'}`;
                errorEl.style.display = 'block';
            }
        } finally {
            // Hide loading
            if (loadingEl) loadingEl.style.display = 'none';
            if (btnEl) {
                (btnEl as HTMLButtonElement).disabled = false;
                btnEl.textContent = '✍️ Generate Blog Post';
            }
        }
    }

    function generateMarkdown(title: string, category: string, date: string, source: string, quote: string, figures: string, context: string, format: string): string {
        let md = `# ${title}\n\n`;
        md += `*${category.charAt(0).toUpperCase() + category.slice(1)} • ${date}*\n\n`;
        
        if (context) md += `${context.substring(0, 200)}...\n\n`;
        if (quote) md += `> "${quote}"\n\n`;
        
        if (figures) {
            md += `## Key Highlights\n\n`;
            figures.split('\n').forEach(f => {
                if (f.trim()) md += `- ${f.replace('• ', '')}\n`;
            });
            md += '\n';
        }
        
        md += `---\n\n`;
        md += `*Source: ${source}*`;
        
        return md;
    }

    // Export Functions
    document.getElementById('copy-markdown')?.addEventListener('click', () => {
        const md = document.getElementById('markdown-output')?.textContent || '';
        navigator.clipboard.writeText(md).then(() => {
            const btn = document.getElementById('copy-markdown');
            if (btn) {
                btn.textContent = '✅ Copied!';
                setTimeout(() => btn.textContent = '📋 Copy Markdown', 2000);
            }
        });
    });

    document.getElementById('download-md')?.addEventListener('click', () => {
        const md = document.getElementById('markdown-output')?.textContent || '';
        const title = document.getElementById('preview-title')?.textContent || 'post';
        const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').substring(0, 50);
        const blob = new Blob([md], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${slug}.md`;
        a.click();
        URL.revokeObjectURL(url);
    });

    document.getElementById('copy-html')?.addEventListener('click', () => {
        const content = document.getElementById('preview-content')?.innerHTML || '';
        const title = document.getElementById('preview-title')?.textContent || '';
        const html = `<article>\n<h1>${title}</h1>\n${content}\n</article>`;
        navigator.clipboard.writeText(html).then(() => {
            const btn = document.getElementById('copy-html');
            if (btn) {
                btn.textContent = '✅ Copied!';
                setTimeout(() => btn.textContent = '🌐 Copy HTML', 2000);
            }
        });
    });

    // Auto-save to localStorage
    const saveInterval = setInterval(() => {
        const rawInput = (document.getElementById('raw-input') as HTMLTextAreaElement)?.value;
        if (rawInput) {
            localStorage.setItem('pressfolio-draft', rawInput);
        }
    }, 5000);

    // Restore draft
    const savedDraft = localStorage.getItem('pressfolio-draft');
    if (savedDraft) {
        const input = document.getElementById('raw-input') as HTMLTextAreaElement;
        if (input) input.value = savedDraft;
    }
</script>
