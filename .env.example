# SEO / analytics configuration (all optional).
# Copy to .env and fill in to activate. These are PUBLIC_* so they are exposed to the
# browser by design (analytics + verification IDs are not secrets).

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Google Search Console HTML tag verification token
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (msvalidate.01)
PUBLIC_BING_SITE_VERIFICATION=
