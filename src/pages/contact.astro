---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
    title="Contact"
    description="Contact the PressFolio team for support, bug reports, feature requests, or partnership questions about the press release to blog converter."
>
    <Header currentPage="/contact" />
    
    <main class="container">
        <div style="text-align: center; padding: 3rem 0;">
            <h1>Get in <span style="color: var(--accent);">Touch</span></h1>
            <p class="hero-tagline">Have feedback, feature requests, or found a bug? We'd love to hear from you.</p>
        </div>

        <div class="contact-grid">
            <div class="contact-form">
                <form id="contact-form">
                    <div class="form-group">
                        <label class="form-label">Your Name</label>
                        <input type="text" class="form-input" placeholder="John Doe" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-input" placeholder="john@example.com" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Subject</label>
                        <select class="form-select">
                            <option>Bug Report</option>
                            <option>Feature Request</option>
                            <option>General Feedback</option>
                            <option>Partnership</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Message</label>
                        <textarea class="form-textarea" style="min-height: 150px;" placeholder="Your message..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Send Message →
                    </button>
                </form>
            </div>

            <div class="contact-info">
                <h3>Other Ways to Reach Us</h3>
                <p>PressFolio is actively maintained. Here's how you can connect:</p>

                <div style="margin-top: 2rem;">
                    <p style="margin-bottom: 1rem;">
                        <strong>🐛 Bug Reports:</strong><br>
                        Use the form above and select "Bug Report"
                    </p>
                    <p style="margin-bottom: 1rem;">
                        <strong>💡 Feature Requests:</strong><br>
                        Select "Feature Request" - we read every suggestion
                    </p>
                    <p>
                        <strong>🤝 Partnerships:</strong><br>
                        Interested in integrating PressFolio? Let's talk.
                    </p>
                </div>

                <div style="margin-top: 2rem; padding: 1.5rem; background: var(--bg-secondary); border-left: 4px solid var(--accent);">
                    <p style="font-size: 0.9rem;"><strong>⏱️ Response Time:</strong><br>We typically respond within 24-48 hours.</p>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Thank you for your message! This is a demo - in production, this would send an email.');
    });
</script>
