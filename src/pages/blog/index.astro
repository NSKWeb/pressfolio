---
import GuideLayout from '../../layouts/GuideLayout.astro';

const posts = [
    {
        title: 'How to Convert a Press Release into a Blog Post',
        description: 'A step-by-step walkthrough of the five-stage conversion workflow, from pasting the raw release to exporting Markdown or HTML.',
        path: '/blog/how-to-convert-a-press-release-into-a-blog-post',
        date: '2026-02-10',
    },
    {
        title: 'Press Release to Blog Post Examples: Before and After',
        description: 'Worked before-and-after examples showing what changes between a raw announcement and a publishable article.',
        path: '/blog/press-release-to-blog-post-examples',
        date: '2026-03-04',
    },
    {
        title: 'The Press Release SEO Checklist',
        description: 'Fifteen checks to run on a converted press release before you publish it, covering titles, descriptions, headings, and structured data.',
        path: '/blog/press-release-seo-checklist',
        date: '2026-04-01',
    },
];
---

<GuideLayout
    eyebrow="Blog"
    heading="Guides, Examples, and Checklists"
    intro="Practical guides for turning press releases and announcements into content you can publish: conversion walkthroughs, worked examples, and pre-publish SEO checks."
    breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }]}
    ctaLabel="Convert a press release free"
>
    <div class="card-grid">
        {posts.map(post => (
            <article class="post-card">
                <p class="post-meta">
                    <time datetime={post.date}>
                        {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                </p>
                <h3><a href={post.path}>{post.title}</a></h3>
                <p>{post.description}</p>
                <a href={post.path}>Read the guide →</a>
            </article>
        ))}
    </div>

    <h2>Start here</h2>
    <p>
        If you already have a press release in hand, the fastest path is the
        <a href="/">converter on the homepage</a>. If you want to understand what the conversion should produce
        before you run it, start with the <a href="/blog/how-to-convert-a-press-release-into-a-blog-post">step-by-step
        guide</a> or the <a href="/press-release-to-blog-post">converter overview</a>.
    </p>
</GuideLayout>